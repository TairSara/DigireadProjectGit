@model DigireadProject.Models.ViewModels.BookViewModel
@section Styles {
    <link href="~/Content/Books/css/book-details.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
}

<div class="book-details">
    <h2>@Model.Title</h2>
    <img src="@Model.ImageSrc" alt="תמונה של @Model.Title" class="book-image" />

    <div class="book-info">
        <p><strong>מחבר ראשי:</strong> @Model.MainAuthor</p>
        <p><strong>הוצאה לאור:</strong> @Model.Publisher</p>
        <p><strong>שנת פרסום:</strong> @Model.PublishYear</p>
        <p><strong>מחיר רכישה:</strong> ₪@Model.PurchasePrice</p>
        @if (Model.IsForRent == true)
        {
            <p><strong>מחיר השכרה:</strong> ₪@Model.RentalPrice</p>
        }
        <p><strong>תיאור:</strong> @Model.Description</p>
        <p><strong>ז'אנר:</strong> @Model.Genre</p>
    </div>

    <div class="actions">
        @if (User.Identity.IsAuthenticated)
        {
            if (Model.StockQuantity > 0)
            {
                <a href="@Url.Action("DirectPurchase", "Order", new { bookId = Model.BookID, isRental = false })"
                   class="btn btn-primary direct-purchase-btn">
                    <i class="fas fa-shopping-cart"></i>
                    רכישה מיידית - ₪@Model.PurchasePrice
                </a>
            }

            if (Model.IsForRent == true && Model.StockQuantityRent > 0)
            {
                <a href="@Url.Action("DirectPurchase", "Order", new { bookId = Model.BookID, isRental = true })"
                   class="btn btn-secondary direct-rental-btn">
                    <i class="fas fa-clock"></i>
                    השכרה מיידית - ₪@Model.RentalPrice
                </a>
            }

            <button onclick="bookManager.showPurchaseOptions()" class="btn btn-outline-primary">
                <i class="fas fa-cart-plus"></i> הוסף לסל
            </button>
        }
        else
        {
            <a href="@Url.Action("Login", "Account")" class="btn btn-primary">
                התחבר כדי לרכוש
            </a>
        }
    </div>
    <div class="reviews-section">
        <h3 class="reviews-title">דירוגים וביקורות</h3>

        <!-- סיכום דירוגים -->
        <div class="ratings-summary">
            <div class="average-rating">
                <div class="big-rating">@Model.AverageRating.ToString("F1")</div>
                <div class="stars">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="fas fa-star @(i <= Math.Round(Model.AverageRating) ? "active" : "")"></i>
                    }
                </div>
                <div class="total-reviews">מתוך @Model.ReviewCount דירוגים</div>
            </div>
        </div>

        <!-- רשימת הביקורות -->
        <div class="reviews-list">
            @if (Model.Reviews.Any())
            {
                foreach (var review in Model.Reviews)
                {
                    <div class="review-card">
                        <div class="review-header">
                            <div class="reviewer-info">
                                <span class="reviewer-name">@review.Username</span>
                                <span class="review-date">@review.ReviewDate.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="stars">
                                @* מציג רק את מספר הכוכבים שווה לדירוג *@
                                @for (int i = 0; i < review.Rating; i++)
                                {
                                    <i class="fas fa-star active"></i>
                                }
                                <span class="rating-value">(@review.Rating)</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(review.Comment))
                        {
                            <p class="review-comment">@review.Comment</p>
                        }
                    </div>
                }
            }
            else
            {
                <p class="no-reviews">אין דירוגים עדיין</p>
            }
        </div>
    </div>

    <!-- Purchase Dialog -->
    <div id="purchaseDialog" class="modal">
        <div class="modal-content">
            <h3>בחר אפשרות רכישה</h3>
            <div class="purchase-options">
                <!-- אפשרות רכישה - או זמין או לא זמין -->
                @if (Model.StockQuantity > 0)
                {
                    <form method="post" action="@Url.Action("AddToCart", "ShoppingCart")">
                        @Html.AntiForgeryToken()
                        @Html.Hidden("bookId", Model.BookID)
                        @Html.Hidden("isRental", false)
                        <button type="submit" class="btn btn-primary purchase-btn">
                            <i class="fas fa-shopping-cart"></i>
                            רכישה - ₪@Model.PurchasePrice
                        </button>
                    </form>
                }
                else
                {
                    <div class="availability-status not-available">
                        <text>הספר אינו זמין לרכישה - אין במלאי</text>
                    </div>
                }

                <!-- אפשרות השאלה - כולל אפשרות להצטרף לרשימת המתנה -->
                @if (Model.IsForRent == true)
                {
                    <form method="post" action="@(Model.StockQuantityRent > 0 ?
                                                Url.Action("AddToCart", "ShoppingCart") :
                                                Url.Action("AddToWaitList", "BookManagement"))">
                        @Html.AntiForgeryToken()
                        @Html.Hidden("bookId", Model.BookID)
                        @Html.Hidden("isRental", true)
                        @if (Model.StockQuantityRent > 0)
                        {
                            <button type="submit" class="btn btn-primary rental-btn">
                                <i class="fas fa-clock"></i>
                                השכרה - ₪@Model.RentalPrice
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-secondary">
                                <i class="fas fa-clock"></i>
                                הצטרף לרשימת המתנה להשאלה
                            </button>
                        }
                    </form>
                }
            </div>
            <button onclick="bookManager.closePurchaseDialog()" class="btn btn-secondary">ביטול</button>
        </div>
    </div>
</div>

<!-- הוספת Modal להודעת שגיאה -->
<div id="errorModal" class="modal">
    <div class="modal-content">
        <h4>שגיאה</h4>
        <p>הספר אינו זמין להשאלה כרגע</p>
        <button onclick="bookManager.closeErrorModal()" class="btn btn-secondary">סגור</button>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Content/Books/js/book-details.js"></script>
}