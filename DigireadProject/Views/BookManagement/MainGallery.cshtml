@model IEnumerable<string>


<div class="text-center">
    <h2 class="title">קטגוריות ספרים</h2>
    <div class="carousel-container">
        <button class="carousel-button carousel-button-left" onclick="scrollCarousel('left')">❮</button>
        <button class="carousel-button carousel-button-right" onclick="scrollCarousel('right')">❯</button>
        <div class="genres-grid" id="genresCarousel">
            @foreach (var genre in Model)
            {
                <a href="@Url.Action("GenreBooks", "BookManagement", new { genre = genre })" class="genre-container">
                    <h3 class="genre-title">@genre</h3>
                    <div class="genre-card">
                        <img src="/Content/@(genre).gif" alt="@genre" class="genre-image">
                        <div class="genre-overlay"></div>
                    </div>
                </a>
            }
        </div>
    </div>

    <style>
        .container.body-content {
            max-width: none !important;
            padding: 0;
            margin: 0;
        }

        .carousel-container {
            position: relative;
            width: 100%;
            margin: 50px auto;
            padding: 0 60px;
        }

        .genres-grid {
            display: flex;
            flex-wrap: nowrap;
            gap: 100px;
            overflow-x: hidden;
            scroll-behavior: smooth;
            padding: 20px 10px;
            margin: 0 auto;
            justify-content: flex-start;
            -webkit-overflow-scrolling: touch;
        }

        .genre-container {
            flex: 0 0 auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 120px; /* Increase the item width */
            text-decoration: none;
            margin: 0 5px;
        }

        .genre-title {
            color: #4b4b4b;
            font-size: 16px; /* Increase the font size */
            font-weight: bold;
            margin-bottom: 6px;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 100%;
        }
        .genre-card {
            position: relative;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            overflow: hidden;
            cursor: pointer;
            transition: transform 0.3s ease;
            border: 4px solid #8e2de2; /* Add a solid border */
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.2); /* Add a subtle box shadow */
        }

        .genre-card:hover {
            transform: scale(1.05);
            border-color: #4a00e0; /* Change the border color on hover */
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.4); /* Increase the box shadow on hover */
        }

        .genre-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease; /* Add a transition for the image transform */
        }

        .genre-card:hover .genre-image {
            transform: scale(1.1); /* Slightly scale up the image on hover */
        }

        .genre-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255, 218, 185, 0.7);
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            transition: opacity 0.3s ease;
            border-radius: 50%;
        }

        .genre-card:hover .genre-overlay {
            opacity: 1;
        }

        .carousel-button {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 35px;
            height: 35px;
            background-color: #fff;
            border: 1px solid #ccc;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
            z-index: 2;
        }

        .title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 120%;  /* קו ארוך יותר מהטקסט */
            height: 4px;
            background: linear-gradient(to right, transparent, #6a11cb, transparent);
            border-radius: 2px;
        }

        .title {
            color: #2c1810;
            font-size: 2.8rem;
            font-weight: 700;
            margin: 0;
            position: relative;
            display: inline-block;
            padding-bottom: 15px;
        }
        .carousel-button-left {
            left: 10px;
        }

        .carousel-button-right {
            right: 10px;
        }

        .carousel-button:hover {
            background-color: #f5f5f5;
        }
    </style>
</div>
@Scripts.Render("~/bundles/jqueryval")
<script src="~/Content/Books/js/GenreCarousel.js"></script>
}