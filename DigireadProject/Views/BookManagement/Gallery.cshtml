@model DigireadProject.Models.ViewModels.GalleryViewModel
@{
    ViewBag.Title = "גלריה";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<main class="gallery-main">
    <!-- כותרת ראשית -->
    <section class="hero-section">
        <div class="container text-center">
            <h2 class="gallery-title">גלריית ספרים</h2>
        </div>
    </section>

    <!-- אזור החיפוש והסינון -->
    <section class="search-section">
        <div class="container">
            <div class="search-filter-section">
                <div class="search-wrapper">
                    <input type="text"
                           id="searchInput"
                           class="search-input"
                           placeholder="חפש לפי כותרת, מחבר, או מוציא לאור"
                           oninput="filterBooks()">
                </div>

                <div class="filters-section">
                    <div class="sort-wrapper">
                        <select id="sortSelect" class="sort-select" onchange="sortBooks()">
                            <option value="">מיין לפי...</option>
                            <option value="title">כותרת</option>
                            <option value="priceAsc">מחיר - מהנמוך לגבוה</option>
                            <option value="priceDesc">מחיר - מהגבוה לנמוך</option>
                            <option value="popularity">פופולריות</option>
                            <option value="year">שנת הוצאה לאור</option>
                            <option value="author">מחבר</option>
                        </select>
                    </div>

                    <div class="checkbox-wrapper">
                        <input type="checkbox" id="saleOnly" onchange="filterBooks()">
                        <label for="saleOnly">הצג רק ספרים במבצע</label>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ניווט ז'אנרים -->
    <section class="genres-section">
        <div class="container">
            <div class="genres-nav">
                <a href="@Url.Action("Gallery", "BookManagement")"
                   class="genre-button @(Model.SelectedGenre == null ? "active" : "")">
                    הכל
                </a>
                @foreach (var genre in Model.Genres)
                {
                    <a href="@Url.Action("GenreBooks", "BookManagement", new { genre = genre })"
                       class="genre-button @(Model.SelectedGenre == genre ? "active" : "")">
                        @genre
                    </a>
                }
            </div>
        </div>
    </section>

    <!-- גלריית הספרים -->
    <section class="books-gallery-section">
        <div class="container">
            <div class="books-grid" id="booksContainer">
                @foreach (var book in Model.Books)
                {
                    var averageRating = book.Reviews?.Where(r => r.RatingBook.HasValue)
                        .Select(r => r.RatingBook.Value)
                        .DefaultIfEmpty(0)
                        .Average() ?? 0;

                    var reviewCount = book.Reviews?.Count(r => r.RatingBook.HasValue) ?? 0;

                    <div class="book-item"
                         data-db-order="@book.BookID"
                         data-title="@book.Title"
                         data-author="@book.MainAuthor"
                         data-publisher="@book.Publisher"
                         data-price="@book.PurchasePrice"
                         data-original-price="@book.OriginalPrice"
                         data-year="@book.PublishYear"
                         data-genre="@book.Genre"
                         data-rating="@averageRating"
                         data-review-count="@reviewCount">
                        <article class="book-card">
                            <a href="BookDetails/@book.BookID" class="book-link">
                                <div class="card @(book.StockQuantity <= 0 ? "out-of-stock" : "")">
                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <div class="wishlist-heart @(ViewBag.UserWishlist?.Contains(book.BookID) == true ? "active" : "")"
                                             onclick="toggleWishlist(event, @book.BookID)">
                                            <i class="@(ViewBag.UserWishlist?.Contains(book.BookID) == true ? "fas" : "far") fa-heart"></i>
                                        </div>
                                    }

                                    @if (book.AgeRestriction > 0)
                                    {
                                        <div class="age-display-badge">
                                            <span class="age-display-text">גיל מומלץ: @book.AgeRestriction+</span>
                                        </div>
                                    }

                                    @if (book.OriginalPrice > book.PurchasePrice)
                                    {
                                        <span class="sale-badge">מבצע</span>
                                    }

                                    @if (!string.IsNullOrEmpty(book.ImageSrc))
                                    {
                                        <div class="card-img-container">
                                            <img src="@book.ImageSrc" class="card-img-top" alt="@book.Title">
                                        </div>
                                    }

                                    <div class="card-body">
                                        <h5 class="card-title">@book.Title</h5>
                                        <div class="book-details">
                                            <p class="author">@book.MainAuthor</p>
                                            <p class="year">@book.PublishYear</p>
                                            <div class="price-section">
                                                @if (book.OriginalPrice > book.PurchasePrice)
                                                {
                                                    <del class="original-price">₪@book.OriginalPrice</del>
                                                    <span class="sale-price">₪@book.PurchasePrice</span>
                                                }
                                                else
                                                {
                                                    <span class="regular-price">₪@book.PurchasePrice</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </article>
                    </div>
                }
            </div>
        </div>
    </section>
    <style>
        /* Global Styles */
        body {
            background: linear-gradient(135deg, #f5f0ff, #e0d1ff);
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #2c1810;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Hero Section - Updated */
        .hero-section {
            padding: 40px 0;
            background: transparent;
            margin-bottom: 30px;
            text-align: center;
        }
        .gallery-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 120%;  /* קו ארוך יותר מהטקסט */
            height: 4px;
            background: linear-gradient(to right, transparent, #6a11cb, transparent);
            border-radius: 2px;
        }

        .gallery-title {
            color: #2c1810;
            font-size: 2.8rem;
            font-weight: 700;
            margin: 0;
            position: relative;
            display: inline-block;
            padding-bottom: 15px;
        }
        /* Search Section */
        .search-section {
            margin-bottom: 40px;
        }

        .search-filter-section {
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(106, 17, 203, 0.1);
        }

        .search-wrapper {
            position: relative;
            margin: 0 auto 25px;  /* מרכוז אוטומטי */
            max-width: 600px;     /* רוחב מקסימלי */
            text-align: center;   /* מרכוז הטקסט */
        }

        .search-input {
            width: 100%;
            padding: 20px 30px;
            border: 2px solid #e0d1ff;
            border-radius: 30px;
            font-size: 1.3rem;
            transition: all 0.3s;
            background: #f8f5ff;
            text-align: center;
            direction: rtl;
            font-weight: 400;
        }

        .search-input:focus {
            border-color: #6a11cb;
            box-shadow: 0 0 0 4px rgba(106, 17, 203, 0.1);
            outline: none;
        }

        /* מרכוז הפילטרים */
        .filters-section {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
            margin-top: 20px;
        }

        /* מרכוז הכותרת */
        .search-filter-section {
            text-align: center;
            padding: 30px;
        }

        .sort-select {
            padding: 10px 20px;
            border: 2px solid #e0d1ff;
            border-radius: 15px;
            font-size: 1rem;
            background: white;
            color: #6a11cb;
            cursor: pointer;
            transition: all 0.3s;
        }

        .sort-select:focus {
            border-color: #6a11cb;
            outline: none;
        }

        /* Checkbox Styling */
        .checkbox-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #f8f5ff;
            padding: 10px 20px;
            border-radius: 20px;
            border: 2px solid #e0d1ff;
            transition: all 0.3s ease;
        }
        .checkbox-wrapper:hover {
            border-color: #6a11cb;
            box-shadow: 0 0 0 4px rgba(106, 17, 203, 0.1);
        }

        /* Custom Checkbox */
        .checkbox-wrapper input[type="checkbox"] {
            appearance: none;
            -webkit-appearance: none;
            width: 20px;
            height: 20px;
            border: 2px solid #6a11cb;
            border-radius: 5px;
            background: white;
            cursor: pointer;
            position: relative;
            transition: all 0.3s ease;
        }

        .checkbox-wrapper input[type="checkbox"]:checked {
            background: #6a11cb;
        }

        .checkbox-wrapper input[type="checkbox"]:checked::before {
            content: '✓';
            position: absolute;
            color: white;
            font-size: 14px;
            font-weight: bold;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
        }

        .checkbox-wrapper label {
            color: #6a11cb;
            font-weight: 500;
            cursor: pointer;
            font-size: 1rem;
        }

        .checkbox-wrapper:hover input[type="checkbox"] {
            transform: scale(1.1);
        }
        /* Genres Navigation */
        .genres-nav {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
            margin: 20px 0;
        }

        .genre-button {
            padding: 10px 20px;
            border: none;
            border-radius: 25px;
            background: white;
            color: #6a11cb;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(106, 17, 203, 0.1);
        }

        .genre-button:hover,
        .genre-button.active {
            background: #6a11cb;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(106, 17, 203, 0.2);
        }

        /* Books Grid */
        .books-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 30px;
            padding: 20px 0;
        }

        /* Book Card */
        .book-card {
            perspective: 1000px;
        }

        .card {
            position: relative;
            background: white;
            border-radius: 15px;
            overflow: hidden;
            transition: transform 0.3s ease-in-out, box-shadow 0.3s ease;
            box-shadow: 0 8px 25px rgba(106, 17, 203, 0.1);
            height: 100%;
        }

        .book-link {
            text-decoration: none;
            color: inherit;
        }

        .card:hover {
            transform: translateY(-10px) rotateX(5deg);
            box-shadow: 0 15px 35px rgba(106, 17, 203, 0.2);
        }

        .card-img-container {
            height: 300px;
            background: linear-gradient(135deg, #FAF7F2, #FFF8EE);
            padding: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card-img-top {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            transition: transform 0.3s ease;
        }

        .card:hover .card-img-top {
            transform: scale(1.05);
        }

        .card-body {
            padding: 20px;
        }

        .card-title {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 10px;
            color: #2c1810;
        }

        /* Badges */
        .sale-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            background: linear-gradient(135deg, #ff4d4d, #ff1a1a);
            color: white;
            padding: 8px 16px;
            border-radius: 25px;
            font-weight: 600;
            box-shadow: 0 4px 8px rgba(255, 26, 26, 0.3);
            z-index: 2;
        }

        .age-restricted-badge {
            position: absolute;
            top: 15px;
            left: 15px;
            background: #2c3e50;
            color: white;
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            font-weight: bold;
            z-index: 2;
        }

        .age-display-badge {
            position: absolute;
            bottom: 15px;
            left: 15px;
            background: rgba(44, 62, 80, 0.8);
            color: white;
            padding: 5px 10px;
            border-radius: 15px;
            font-size: 0.9rem;
            z-index: 2;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .age-display-badge::before {
            content: '👤';
            font-size: 1rem;
        }

        /* Book Details */
        .book-details {
            font-size: 0.95rem;
        }

        .author, .year {
            margin: 5px 0;
            color: #666;
        }

        .price-section {
            margin-top: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .original-price {
            color: #ea5b5b;
            text-decoration: line-through;
            font-size: 0.9rem;
        }

        .sale-price {
            color: #9cd68a;
            font-weight: bold;
            font-size: 1.2rem;
        }

        .regular-price {
            font-size: 1.2rem;
            color: #110919;
            font-weight: bold;
        }

        /* Out of Stock */
        .out-of-stock {
            opacity: 0.7;
        }

        .out-of-stock img {
            filter: grayscale(50%);
        }

        .books-grid {
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }

        .card-img-container {
            height: 250px;
        }

        .search-filter-section {
            padding: 20px;
        }
        /* תיקון העיצוב של הלב */
        .wishlist-heart {
            position: absolute;
            top: 15px;
            left: 15px;  /* מיקום בצד שמאל */
            z-index: 3;
            cursor: pointer;
            background: white;
            border-radius: 50%;
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 15px rgba(106, 17, 203, 0.15);  /* צל משופר */
            transition: all 0.3s ease;
        }

        .wishlist-heart i {
            font-size: 1.2rem;
            color: #666;
            transition: all 0.3s ease;
        }

        .wishlist-heart:hover {
            transform: scale(1.1);
            box-shadow: 0 6px 20px rgba(106, 17, 203, 0.2);  /* צל משופר במצב hover */
        }

        .wishlist-heart.active {
            background: #fff5f5;  /* רקע קל בצבע אדום כשפעיל */
        }

        .wishlist-heart.active i {
            color: #ff4d4d !important;
        }

        /* מיקום מחדש של תגית הגיל אם יש התנגשות */
        .age-restricted-badge {
            position: absolute;
            top: 15px;
            left: 60px;  /* הזזה ימינה כדי לא להתנגש עם הלב */
            background: #2c3e50;
            color: white;
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            font-weight: bold;
            z-index: 2;
        }
    </style>

    <script src="~/Content/Books/js/gallery.js"></script>
</main>

<script>
    function toggleWishlist(event, bookId) {
        event.preventDefault();
        event.stopPropagation();

        const heartIcon = event.target;
        const heartContainer = heartIcon.closest('.wishlist-heart');

        fetch('/Wishlist/Toggle', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ bookId: bookId })
        })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    // Toggle classes for the icon
                    heartIcon.classList.toggle('far');
                    heartIcon.classList.toggle('fas');
                    heartIcon.classList.toggle('active-heart');

                    // Update the color explicitly
                    if (heartIcon.classList.contains('fas')) {
                        heartIcon.style.color = '#ff4d4d';
                    } else {
                        heartIcon.style.color = '#666';
                    }
                } else {
                    console.error('Toggle was not successful:', data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
            });
    }


</script>