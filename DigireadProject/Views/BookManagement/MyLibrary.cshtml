@model IEnumerable<DigireadProject.Models.ViewModels.MyLibraryViewModel>
@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
    <link href="~/Content/Books/css/MyLibrary.css" rel="stylesheet" />
}
@{
    ViewBag.Title = "הספרייה שלי";
}
@Html.AntiForgeryToken()
<div class="library-container" dir="rtl">
    <h2 class="title">הספרייה שלי</h2>

    @if (TempData["ExpiredRentals"] != null)
    {
        <div class="alert alert-info" role="alert" dir="rtl">
            שים לב: חלק מהספרים המושאלים הוסרו מהספרייה שלך עקב פקיעת תוקף ההשאלה
        </div>
    }

    <div class="books-grid">
        @foreach (var book in Model)
        {
            <div class="book-card">
                <div class="book-image">
                    @if (!string.IsNullOrEmpty(book.ImageSrc))
                    {
                        <img src="@Url.Content(book.ImageSrc)" alt="@book.Title" />
                    }
                    else
                    {
                        <img src="~/Content/Images/default-book.jpg" alt="תמונה לא זמינה" />
                    }
                </div>
                <div class="book-info">
                    <h3>@book.Title</h3>
                    <p>מאת: @book.Author</p>
                    <div class="book-type">@book.Type</div>
                    @if (book.Type == "השאלה" && book.ReturnDate.HasValue)
                    {
                        <div class="return-date">
                            תאריך החזרה: @book.ReturnDate.Value.ToString("dd/MM/yyyy")
                        </div>

                        var daysLeft = (book.ReturnDate.Value - DateTime.Now).Days;
                        <div class="days-left">
                            נותרו @daysLeft ימים להשאלה
                        </div>

                        if (daysLeft <= 5 && daysLeft > 0)
                        {
                            <div class="days-left-warning">
                                נותרו @daysLeft ימים להשכרה
                            </div>
                        }
                    }
                   
                    <button class="download-btn" onclick="showFormatDialog(@book.BookId)">
                        <i class="fas fa-download"></i> הורד ספר
                    </button>
                    
                    <button class="delete-btn" onclick="confirmDelete(@book.BookId, '@book.Type', '@book.Title')">
                        <i class="fas fa-trash"></i> מחק
                    </button>

                    <button class="rate-btn" data-book-id="@book.BookId" data-book-title="@book.Title">
                        <i class="fas fa-star"></i> דרג ספר
                    </button>
                </div>
            </div>
        }
    </div>
</div>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/js/all.min.js"></script>
    
    <script>
        $(document).ready(function() {
            // בדיקת כל הספרים שבספרייה
            $('.rate-btn').each(function() {
                const $button = $(this);
                const bookId = $button.data('book-id');

                $.get('/Reviews/HasUserReviewedBook', { bookId: bookId }, function(response) {
                    if (response.hasReviewed) {
                        $button.prop('disabled', true)
                            .addClass('already-rated')
                            .html('<i class="fas fa-star"></i> כבר דירגת');
                    }
                });
            });

            // הוספת טיפול באירוע לחיצה על כפתור הדירוג
            $('.rate-btn').on('click', function() {
                if (!$(this).hasClass('already-rated')) {
                    const bookId = $(this).data('book-id');
                    const bookTitle = $(this).data('book-title');
                    showRatingDialog(bookId, bookTitle);
                }
            });
        });
        function confirmDelete(bookId, type, title) {
            Swal.fire({
                title: 'האם אתה בטוח?',
                html: `האם אתה בטוח שברצונך למחוק את הספר <strong>${title}</strong> מהספרייה שלך?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'כן, מחק',
                cancelButtonText: 'ביטול',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    deleteBook(bookId, type);
                }
            });
        }

        function deleteBook(bookId, type) {
            console.log('מנסה למחוק ספר:', { bookId, type }); // הוספת לוג

            $.ajax({
                url: '/BookManagement/DeleteFromLibrary',
                type: 'POST',
                data: {
                    bookId: bookId,
                    type: type,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    console.log('תגובת השרת:', response); // הוספת לוג
                    if (response.success) {
                        Swal.fire({
                            title: 'נמחק!',
                            text: 'הספר נמחק בהצלחה מהספרייה שלך',
                            icon: 'success'
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        console.error('שגיאת שרת:', response.message); // הוספת לוג
                        Swal.fire(
                            'שגיאה!',
                            response.message || 'אירעה שגיאה במחיקת הספר',
                            'error'
                        );
                    }
                },
                error: function(xhr, status, error) {
                    console.error('שגיאת AJAX:', { status, error, responseText: xhr.responseText }); // הוספת לוג מפורט
                    Swal.fire(
                        'שגיאה!',
                        'אירעה שגיאה במחיקת הספר',
                        'error'
                    );
                }
            });
        }

        function showFormatDialog(bookId) {
            Swal.fire({
                title: 'בחר פורמט להורדה',
                html: `
                    <div class="format-options" dir="rtl">
                        <button class="format-btn" onclick="downloadBook(${bookId}, 'PDF')">PDF</button>
                        <button class="format-btn" onclick="downloadBook(${bookId}, 'EPUB')">EPUB</button>
                        <button class="format-btn" onclick="downloadBook(${bookId}, 'MOBI')">MOBI</button>
                        <button class="format-btn" onclick="downloadBook(${bookId}, 'FB2')">FB2</button>
                    </div>
                `,
                showConfirmButton: false,
                showCloseButton: true,
                customClass: {
                    popup: 'format-dialog'
                }
            });
        }

        function downloadBook(bookId, format) {
            $.ajax({
                url: '/BookManagement/DownloadBook',
                type: 'POST',
                data: {
                    bookId: bookId,
                    format: format,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    console.log('Download response:', response);
                    if (response.success) {
                        // Create a temporary link to download the file
                        const link = document.createElement('a');
                        link.href = response.downloadUrl;
                        link.download = response.fileName;
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);

                        Swal.close();
                    } else {
                        Swal.fire({
                            title: 'שגיאה!',
                            text: response.message || 'אירעה שגיאה בהורדת הספר',
                            icon: 'error'
                        });
                    }
                },
                error: function() {
                    console.error('Download error:', { status, error, response: xhr.responseText });
                    Swal.fire({
                        title: 'שגיאה!',
                        text: 'אירעה שגיאה בהורדת הספר',
                        icon: 'error'
                    });
                }
            });
        }


        function showRatingDialog(bookId, title) {
            console.log('Opening rating dialog for:', {bookId, title});
            // בדיקה האם המשתמש כבר דירג את הספר
            $.get('/Reviews/HasUserReviewedBook', {bookId: bookId}, function (response) {
                if (response.hasReviewed) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'לא ניתן לדרג',
                        text: 'כבר דירגת את הספר הזה בעבר',
                        confirmButtonText: 'אישור'
                    });
                    return;
                }

                let currentRating = 0;

                Swal.fire({
                    title: `דרג את הספר "${title}"`,
                    html: `
            <div class="rating-container">
                <div class="star-rating">
                    <span class="star" data-rating="1">★</span>
                    <span class="star" data-rating="2">★</span>
                    <span class="star" data-rating="3">★</span>
                    <span class="star" data-rating="4">★</span>
                    <span class="star" data-rating="5">★</span>
                </div>
                <div id="rating-text">בחר דירוג</div>
            </div>
            <textarea id="reviewText" class="swal2-textarea" placeholder="כתוב את חוות דעתך כאן..." dir="rtl"></textarea>
        `,
                    showCancelButton: true,
                    confirmButtonText: 'שלח דירוג',
                    cancelButtonText: 'ביטול',
                    customClass: {
                        container: 'custom-swal-container',
                        popup: 'custom-swal-popup',
                        content: 'custom-swal-content'
                    },
                    didOpen: (popup) => {
                        const ratingDescriptions = ['גרוע', 'לא טוב', 'סביר', 'טוב', 'מצוין'];
                        const stars = popup.querySelectorAll('.star');
                        const ratingText = popup.querySelector('#rating-text');

                        stars.forEach(star => {
                            // טיפול באירוע hover
                            star.addEventListener('mouseenter', () => {
                                const rating = parseInt(star.dataset.rating);
                                stars.forEach((s, index) => {
                                    if (index < rating) {
                                        s.classList.add('active');
                                    } else {
                                        s.classList.remove('active');
                                    }
                                });
                                ratingText.textContent = ratingDescriptions[rating - 1];
                            });

                            // טיפול בלחיצה
                            star.addEventListener('click', () => {
                                currentRating = parseInt(star.dataset.rating);
                                stars.forEach((s, index) => {
                                    if (index < currentRating) {
                                        s.classList.add('selected');
                                    } else {
                                        s.classList.remove('selected');
                                    }
                                });
                            });
                        });

                        // טיפול ביציאת העכבר מאזור הכוכבים
                        const container = popup.querySelector('.star-rating');
                        container.addEventListener('mouseleave', () => {
                            stars.forEach((s, index) => {
                                s.classList.remove('active');
                                if (index < currentRating) {
                                    s.classList.add('selected');
                                }
                            });
                            ratingText.textContent = currentRating ? ratingDescriptions[currentRating - 1] : 'בחר דירוג';
                        });
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        if (currentRating === 0) {
                            Swal.fire('שגיאה', 'אנא בחר דירוג', 'error');
                            return;
                        }
                        const reviewText = document.getElementById('reviewText').value;
                        submitRating(bookId, currentRating, reviewText);
                    }
                });
            })

            function updateStars(stars, rating, className) {
                stars.forEach((star, index) => {
                    const starRating = parseInt(star.dataset.rating);
                    if (starRating <= rating) {
                        star.classList.add(className);
                    } else {
                        star.classList.remove(className);
                    }
                });
            }

            function submitRating(bookId, rating, reviewText) {
                console.log('Submitting rating:', {bookId, rating, reviewText});

                $.ajax({
                    url: '/Reviews/AddBookReview',
                    type: 'POST',
                    contentType: 'application/x-www-form-urlencoded',
                    data: {
                        bookId: bookId,
                        rating: rating,
                        reviewText: reviewText,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    beforeSend: function () {
                        Swal.showLoading();
                    },
                    success: function (response) {
                        console.log('Server response:', response);

                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'תודה!',
                                text: response.message,
                                confirmButtonText: 'אישור'
                            });
                        } else {
                            if (response.message === "יש להתחבר למערכת") {
                                Swal.fire({
                                    title: 'שגיאה',
                                    text: 'יש להתחבר למערכת כדי לדרג ספרים',
                                    icon: 'error',
                                    confirmButtonText: 'התחבר',
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        window.location.href = '/Account/Login';
                                    }
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'שגיאה',
                                    text: response.message,
                                    confirmButtonText: 'אישור'
                                });
                            }
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Ajax error:', {
                            status: status,
                            error: error,
                            response: xhr.responseText
                        });

                        Swal.fire({
                            icon: 'error',
                            title: 'שגיאה',
                            text: 'אירעה שגיאה בשמירת הדירוג',
                            confirmButtonText: 'אישור'
                        });
                    }
                });
            }

            $(document).ready(function () {
                // הוספת טיפול באירוע לחיצה על כפתור הדירוג
                $('.rate-btn').on('click', function () {
                    const bookId = $(this).data('book-id');
                    const bookTitle = $(this).data('book-title');
                    showRatingDialog(bookId, bookTitle);
                });
            });
        }
    </script>
}
<style>
    * {
        font-family: 'Rubik', 'Assistant', 'Heebo', Arial, sans-serif;
    }

    .library-container {
        padding: 20px;
        max-width: 1200px;
        margin: 0 auto;
        background: linear-gradient(135deg, #FAF7F2, #FFF8EE);
    }

    /* עיצוב הכותרת */
    .title {
        color: #333;
        text-align: center;
        font-size: 2rem;
        font-weight: 600;
        margin-bottom: 2rem;
        position: relative;
        padding-bottom: 1rem;
    }

    .title:after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100px;
        height: 3px;
        background: linear-gradient(to right, #9580ff, #6c50e8);
        border-radius: 2px;
    }

    .books-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 25px;
        margin-top: 20px;
    }

    .book-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(149, 128, 255, 0.1);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid #f4ecff;
    }

    .book-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(149, 128, 255, 0.2);
    }

    .book-image img {
        width: 100%;
        height: 280px;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .book-image img:hover {
        transform: scale(1.05);
    }

    .book-info {
        padding: 20px;
        background: linear-gradient(to bottom, #fff, #f8f5ff);
    }

    .book-info h3 {
        margin: 0;
        font-size: 1.1em;
        margin-bottom: 10px;
        font-weight: 600;
        color: #6c50e8;
    }

    .download-btn {
        background-color: #9580ff;
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 8px;
        margin-top: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
        width: 100%;
        margin-bottom: 8px;
        box-shadow: 0 4px 15px rgba(149, 128, 255, 0.2);
    }

    .download-btn:hover {
        background-color: #6c50e8;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(149, 128, 255, 0.3);
    }

    .book-info p {
        margin: 8px 0;
        color: #7b6d9e;
    }

    .book-type {
        display: inline-block;
        padding: 5px 12px;
        background-color: #f4ecff;
        color: #6c50e8;
        border-radius: 6px;
        font-size: 0.9em;
        margin-top: 8px;
        font-weight: 500;
    }

    .return-date {
        margin-top: 8px;
        font-size: 0.9em;
        color: #7b6d9e;
        background-color: #f8f5ff;
        padding: 5px 12px;
        border-radius: 6px;
    }

    .alert {
        margin-bottom: 20px;
        padding: 15px;
        border-radius: 8px;
    }

    .alert-info {
        background-color: #f4ecff;
        border: 1px solid #e6e0ff;
        color: #6c50e8;
    }

    .delete-btn {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 8px;
        margin-top: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
        width: 100%;
    }

    .delete-btn:hover {
        background-color: #c82333;
        transform: translateY(-2px);
    }

    /* עיצוב כפתורי דירוג */
    .rate-btn {
        background-color: #9580ff;
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 8px;
        margin-top: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
        width: 100%;
        margin-bottom: 8px;
    }

    .rate-btn:hover {
        background-color: #6c50e8;
        transform: translateY(-2px);
    }

    .rate-btn.already-rated {
        background-color: #e6e0ff;
        cursor: not-allowed;
        opacity: 0.7;
    }

    /* עיצוב כוכבי דירוג */
    .rating-stars {
        display: flex;
        gap: 8px;
        justify-content: center;
        margin: 15px 0;
    }

    .star {
        font-size: 24px;
        color: #e6e0ff;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .star:hover,
    .star.active,
    .star.selected {
        color: #9580ff;
        transform: scale(1.2);
    }

    .star.selected {
        animation: pulse 0.3s ease-in-out;
    }

    /* עיצוב חלון הדירוג */
    .rating-container {
        text-align: center;
        padding: 20px;
        background-color: white;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(149, 128, 255, 0.15);
    }

    .rating-text {
        color: #7b6d9e;
        margin: 10px 0;
        font-size: 0.9em;
    }
</style>
