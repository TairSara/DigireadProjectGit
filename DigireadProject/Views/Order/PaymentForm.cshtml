@model DigireadProject.Models.ViewModels.PaymentViewModel

@{
    ViewBag.Title = "תשלום מאובטח";
}

<div class="payment-container" dir="rtl">
    <div class="payment-form-wrapper">
        <div class="payment-header">
            <h2><i class="fas fa-lock"></i> תשלום מאובטח</h2>
        </div>

        <!-- הוספת אזור פרטי הספר -->
        <div class="book-summary">
            <div class="book-info">
                <img src="@Model.BookImageSrc" alt="@Model.BookTitle" class="book-thumbnail" />
                <div class="book-details">
                    <h3>@Model.BookTitle</h3>
                    <p class="transaction-type">@(Model.IsRental ? "השכרה" : "רכישה")</p>
                    <div class="total-amount">
                        סה"כ לתשלום: ₪@Model.Price
                    </div>
                </div>
            </div>
        </div>

        @using (Html.BeginForm("ProcessPayment", "Order", FormMethod.Post, new { @class = "payment-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <!-- הוספת שדות נסתרים לשמירת מידע הספר -->
            @Html.HiddenFor(m => m.BookId)
            @Html.HiddenFor(m => m.IsRental)
            @Html.HiddenFor(m => m.Price)
            @Html.HiddenFor(m => m.BookTitle)
            @Html.HiddenFor(m => m.BookImageSrc)

            <div class="form-group">
                <label>מספר כרטיס אשראי</label>
                @Html.TextBoxFor(m => m.CardNumber, new {
                    @class = "form-control",
                    placeholder = "XXXX-XXXX-XXXX-XXXX",
                    maxlength = "16"
                })
                @Html.ValidationMessageFor(m => m.CardNumber, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>שם בעל הכרטיס</label>
                @Html.TextBoxFor(m => m.CardHolderName, new {
                    @class = "form-control",
                    placeholder = "שם מלא כפי שמופיע על הכרטיס"
                })
                @Html.ValidationMessageFor(m => m.CardHolderName, "", new { @class = "text-danger" })
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>תוקף</label>
                    @Html.TextBoxFor(m => m.ExpiryDate, new {
                        @class = "form-control",
                        placeholder = "MM/YY",
                        maxlength = "5"
                    })
                    @Html.ValidationMessageFor(m => m.ExpiryDate, "", new { @class = "text-danger" })
                </div>

                <div class="form-group col-md-6">
                    <label>CVV</label>
                    @Html.TextBoxFor(m => m.CVV, new {
                        @class = "form-control",
                        placeholder = "123",
                        maxlength = "3",
                        type = "password"
                    })
                    @Html.ValidationMessageFor(m => m.CVV, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-block">
                    <i class="fas fa-lock"></i>
                    אשר תשלום
                </button>
                <a href="@Url.Action("BookDetails", "BookManagement", new { id = Model.BookId })"
                   class="btn btn-outline-secondary btn-block">
                    <i class="fas fa-arrow-right"></i>
                    חזור לפרטי הספר
                </a>
            </div>
        }
    </div>
</div>

@section Styles {
    <link href="~/Content/Order/css/Payment.css" rel="stylesheet" />
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Content/Order/js/payment.js"></script>
}