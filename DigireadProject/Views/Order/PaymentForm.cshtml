@model DigireadProject.Models.ViewModels.PaymentViewModel

@{
    ViewBag.Title = "תשלום מאובטח";
}

<div class="payment-container" dir="rtl">
    <div class="payment-form-wrapper">
        <div class="payment-header">
            <h2><i class="fas fa-lock"></i> תשלום מאובטח</h2>
        </div>

        <div class="book-summary">
            @foreach (var item in Model.CartItems)
            {
                <div class="cart-item">
                    <img src="@item.BookImageSrc" alt="@item.BookTitle" class="book-thumbnail" />
                    <div class="book-details">
                        <h3>@item.BookTitle</h3>
                        <p class="transaction-type">@(item.IsRental ? "השכרה" : "רכישה")</p>
                        <p>כמות: @item.Quantity</p>
                        <p class="price">₪@item.Price</p>
                    </div>
                </div>
            }
            <div class="total-amount">
                סה"כ לתשלום: ₪@Model.Price
            </div>
        </div>

        @using (Html.BeginForm("ProcessPayment", "Order", FormMethod.Post, new { @class = "payment-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            for (int i = 0; i < Model.CartItems.Count; i++)
            {
                @Html.HiddenFor(m => m.CartItems[i].BookId)
                @Html.HiddenFor(m => m.CartItems[i].BookTitle)
                @Html.HiddenFor(m => m.CartItems[i].BookImageSrc)
                @Html.HiddenFor(m => m.CartItems[i].Price)
                @Html.HiddenFor(m => m.CartItems[i].Quantity)
                @Html.HiddenFor(m => m.CartItems[i].IsRental)
            }

            <div class="form-group">
                <label>מספר כרטיס אשראי</label>
                @Html.TextBoxFor(m => m.CardNumber, new {
                    @class = "form-control",
                    placeholder = "XXXX-XXXX-XXXX-XXXX",
                    maxlength = "16"
                })
                @Html.ValidationMessageFor(m => m.CardNumber, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>שם בעל הכרטיס</label>
                @Html.TextBoxFor(m => m.CardHolderName, new {
                    @class = "form-control",
                    placeholder = "שם מלא כפי שמופיע על הכרטיס"
                })
                @Html.ValidationMessageFor(m => m.CardHolderName, "", new { @class = "text-danger" })
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>תוקף</label>
                    @Html.TextBoxFor(m => m.ExpiryDate, new {
                        @class = "form-control",
                        placeholder = "MM/YY",
                        maxlength = "5"
                    })
                    @Html.ValidationMessageFor(m => m.ExpiryDate, "", new { @class = "text-danger" })
                </div>

                <div class="form-group col-md-6">
                    <label>CVV</label>
                    @Html.TextBoxFor(m => m.CVV, new {
                        @class = "form-control",
                        placeholder = "123",
                        maxlength = "3",
                        type = "password"
                    })
                    @Html.ValidationMessageFor(m => m.CVV, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-block">
                    <i class="fas fa-lock"></i>
                    אשר תשלום
                </button>
                <a href="@Url.Action("BookDetails", "BookManagement", new { id = Model.BookId })"
                   class="btn btn-outline-secondary btn-block">
                    <i class="fas fa-arrow-right"></i>
                    חזור לפרטי הספר
                </a>
            </div>
        }
    </div>
</div>
<style>
    .payment-container {
        background-color: #f4ecf7;
        padding: 2rem;
        border-radius: 10px;
        max-width: 800px;
        margin: 2rem auto;
    }

    .payment-form-wrapper {
        background-color: white;
        padding: 2rem;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(142, 68, 173, 0.1);
    }

    .payment-header {
        color: #8e44ad;
        margin-bottom: 2rem;
        text-align: center;
    }

    .payment-header h2 {
        font-weight: bold;
    }

    .book-summary {
        padding: 1.5rem;
        text-align: right;
    }

    .cart-item {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 15px;
        padding: 10px;
        margin-bottom: 10px;
        border-bottom: 1px solid #eee;
    }

    .book-info {
        display: flex;
        gap: 1.5rem;
        align-items: center;
    }

    .book-thumbnail {
        width: 80px;
        height: auto;
    }

    .book-details h3 {
        color: #8e44ad;
        margin-bottom: 0.5rem;
    }

    .book-details {
        text-align: right;
    }

    .price {
        color: #8e44ad;
        font-weight: bold;
    }

    .total-amount {
        margin-top: 20px;
        font-size: 1.2rem;
        color: #8e44ad;
        text-align: right;
    }

    .form-group label {
        color: #8e44ad;
        font-weight: 600;
    }

    .form-control {
        border: 2px solid #d2b4de;
        border-radius: 6px;
        padding: 0.75rem;
        transition: border-color 0.3s ease;
    }

    .form-control:focus {
        border-color: #8e44ad;
        box-shadow: 0 0 0 0.2rem rgba(142, 68, 173, 0.25);
    }

    .transaction-type {
        color: #666;
        font-size: 0.9rem;
    }

    .btn-primary {
        background-color: #8e44ad;
        border-color: #8e44ad;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background-color: #9b59b6;
        border-color: #9b59b6;
        transform: translateY(-1px);
    }

    .btn-outline-secondary {
        color: #8e44ad;
        border-color: #8e44ad;
    }

    .btn-outline-secondary:hover {
        background-color: #f4ecf7;
        color: #8e44ad;
    }

    .text-danger {
        color: #e74c3c;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .form-actions {
        margin-top: 2rem;
    }

    .form-actions .btn {
        margin-bottom: 1rem;
    }



    .shake {
        animation: shake 0.5s ease-in-out;
    }
</style>

@section Styles {
    <link href="~/Content/Order/css/Payment.css" rel="stylesheet" />
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Content/Order/js/payment.js"></script>

<script>
    // בדיקה האם יש מידע על רשימת המתנה
    @if (TempData["WaitListInfo"] != null)
    {
        <text>
            $(document).ready(function() {
                var waitListInfo = @Html.Raw(Json.Encode(TempData["WaitListInfo"]));
                Swal.fire({
                    title: 'הספר אינו זמין',
                    html: `
                        <div dir="rtl" class="text-right">
                            <p>הספר ${waitListInfo.BookTitle} אינו זמין כרגע ${waitListInfo.IsRental ? 'להשכרה' : 'לרכישה'}.</p>
                            <p>ישנם ${waitListInfo.WaitingCount} אנשים ברשימת ההמתנה.</p>
                            <p>המיקום שלך יהיה: ${waitListInfo.WaitingCount + 1}</p>
                            <p>האם ברצונך להצטרף לרשימת ההמתנה?</p>
                        </div>
                    `,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'הצטרף לרשימת המתנה',
                    cancelButtonText: 'לא תודה',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("JoinWaitList", "Order")',
                            type: 'POST',
                            data: {
                                bookId: waitListInfo.BookId,
                                isRental: waitListInfo.IsRental,
                                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function(response) {
                                if (response.success) {
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'נוספת בהצלחה!',
                                        text: response.message,
                                        confirmButtonText: 'אישור'
                                    }).then(() => {
                                        window.location.href = response.redirectUrl;
                                    });
                                } else {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'שגיאה',
                                        text: response.message,
                                        confirmButtonText: 'אישור'
                                    });
                                }
                            }
                        });
                    } else {
                        window.location.href = '@Url.Action("BookDetails", "BookManagement", new { id = "BOOK_ID" })'.replace('BOOK_ID', waitListInfo.BookId);
                    }
                });
            });
        </text>
    }
</script>
}
}