@model DigireadProject.Models.ViewModels.PaymentViewModel

@{
    ViewBag.Title = "תשלום מאובטח";
}

<div class="payment-container" dir="rtl">
    <div class="payment-form-wrapper">
        <div class="payment-header">
            <h2><i class="fas fa-lock"></i> תשלום מאובטח</h2>
        </div>

        <div class="book-summary">
            @for (int i = 0; i < Model.CartItems.Count; i++)
            {
                var item = Model.CartItems[i];
                <div class="cart-item" data-item-index="@i">
                    <img src="@item.BookImageSrc" alt="@item.BookTitle" class="book-thumbnail" />
                    <div class="book-details">
                        <h3>@item.BookTitle</h3>
                        <div class="transaction-type-selector">
                            <div class="form-check">
                                @Html.RadioButtonFor(m => m.CartItems[i].IsRental, false, new {
                                    @class = "form-check-input transaction-type-radio",
                                    data_book_id = item.BookId,
                                    data_purchase_price = item.PurchasePrice,
                                    data_rental_price = item.RentalPrice,
                                    id = $"purchase-{item.BookId}"
                                })
                                <label class="form-check-label" for="purchase-@item.BookId">
                                    רכישה (₪@item.PurchasePrice)
                                </label>
                            </div>
                            @if (item.CanBeRented)
                            {
                                <div class="form-check">
                                    @Html.RadioButtonFor(m => m.CartItems[i].IsRental, true, new {
                                        @class = "form-check-input transaction-type-radio",
                                        data_book_id = item.BookId,
                                        data_purchase_price = item.PurchasePrice,
                                        data_rental_price = item.RentalPrice,
                                        id = $"rental-{item.BookId}"
                                    })
                                    <label class="form-check-label" for="rental-@item.BookId">
                                        השכרה (₪@item.RentalPrice)
                                    </label>
                                </div>
                            }
                        </div>
                        <p>כמות: @item.Quantity</p>
                        <p class="price">₪@item.Price</p>
                    </div>
                </div>
            }
            <div class="total-amount">
                סה"כ לתשלום: ₪@Model.Price
            </div>
        </div>

        @using (Html.BeginForm("ProcessPayment", "Order", FormMethod.Post, new { @class = "payment-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            for (int i = 0; i < Model.CartItems.Count; i++)
            {
                @Html.HiddenFor(m => m.CartItems[i].BookId)
                @Html.HiddenFor(m => m.CartItems[i].BookTitle)
                @Html.HiddenFor(m => m.CartItems[i].BookImageSrc)
                @Html.HiddenFor(m => m.CartItems[i].Price)
                @Html.HiddenFor(m => m.CartItems[i].PurchasePrice)
                @Html.HiddenFor(m => m.CartItems[i].RentalPrice)
                @Html.HiddenFor(m => m.CartItems[i].Quantity)
                @Html.HiddenFor(m => m.CartItems[i].IsRental)
                @Html.HiddenFor(m => m.CartItems[i].CanBeRented)
            }

            <div class="form-group">
                <label>מספר כרטיס אשראי</label>
                @Html.TextBoxFor(m => m.CardNumber, new {
                    @class = "form-control",
                    placeholder = "XXXX-XXXX-XXXX-XXXX",
                    maxlength = "16"
                })
                @Html.ValidationMessageFor(m => m.CardNumber, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>שם בעל הכרטיס</label>
                @Html.TextBoxFor(m => m.CardHolderName, new {
                    @class = "form-control",
                    placeholder = "שם מלא כפי שמופיע על הכרטיס"
                })
                @Html.ValidationMessageFor(m => m.CardHolderName, "", new { @class = "text-danger" })
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label>תוקף</label>
                    @Html.TextBoxFor(m => m.ExpiryDate, new {
                        @class = "form-control",
                        placeholder = "MM/YY",
                        maxlength = "5"
                    })
                    @Html.ValidationMessageFor(m => m.ExpiryDate, "", new { @class = "text-danger" })
                </div>

                <div class="form-group col-md-6">
                    <label>CVV</label>
                    @Html.TextBoxFor(m => m.CVV, new {
                        @class = "form-control",
                        placeholder = "123",
                        maxlength = "3",
                        type = "password"
                    })
                    @Html.ValidationMessageFor(m => m.CVV, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-block">
                    <i class="fas fa-lock"></i>
                    אשר תשלום
                </button>
                <a href="@Url.Action("BookDetails", "BookManagement", new { id = Model.BookId })"
                   class="btn btn-outline-secondary btn-block">
                    <i class="fas fa-arrow-right"></i>
                    חזור לפרטי הספר
                </a>
            </div>
        }
    </div>
</div>

<style>
    .payment-container {
        background-color: #f4ecf7;
        padding: 2rem;
        border-radius: 10px;
        max-width: 800px;
        margin: 2rem auto;
    }

    .payment-form-wrapper {
        background-color: white;
        padding: 2rem;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(142, 68, 173, 0.1);
    }

    .payment-header {
        color: #8e44ad;
        margin-bottom: 2rem;
        text-align: center;
    }

    .payment-header h2 {
        font-weight: bold;
    }

    .book-summary {
        padding: 1.5rem;
        text-align: right;
    }

    .cart-item {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 15px;
        padding: 10px;
        margin-bottom: 10px;
        border-bottom: 1px solid #eee;
    }

    .book-info {
        display: flex;
        gap: 1.5rem;
        align-items: center;
    }

    .book-thumbnail {
        width: 80px;
        height: auto;
    }

    .book-details h3 {
        color: #8e44ad;
        margin-bottom: 0.5rem;
    }

    .book-details {
        text-align: right;
    }

    .price {
        color: #8e44ad;
        font-weight: bold;
    }

    .total-amount {
        margin-top: 20px;
        font-size: 1.2rem;
        color: #8e44ad;
        text-align: right;
    }

    .form-group label {
        color: #8e44ad;
        font-weight: 600;
    }

    .form-control {
        border: 2px solid #d2b4de;
        border-radius: 6px;
        padding: 0.75rem;
        transition: border-color 0.3s ease;
    }

    .form-control:focus {
        border-color: #8e44ad;
        box-shadow: 0 0 0 0.2rem rgba(142, 68, 173, 0.25);
    }

    .transaction-type-selector {
        margin: 10px 0;
        display: flex;
        gap: 15px;
    }

    .form-check {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
    }

    .form-check-input {
        margin: 0;
    }

    .form-check-label {
        margin: 0;
        color: #666;
        cursor: pointer;
    }

    .btn-primary {
        background-color: #8e44ad;
        border-color: #8e44ad;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        background-color: #9b59b6;
        border-color: #9b59b6;
        transform: translateY(-1px);
    }

    .btn-outline-secondary {
        color: #8e44ad;
        border-color: #8e44ad;
    }

    .btn-outline-secondary:hover {
        background-color: #f4ecf7;
        color: #8e44ad;
    }

    .text-danger {
        color: #e74c3c;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .form-actions {
        margin-top: 2rem;
    }

    .form-actions .btn {
        margin-bottom: 1rem;
    }

    .shake {
        animation: shake 0.5s ease-in-out;
    }
</style>

@section Styles {
    <link href="~/Content/Order/css/Payment.css" rel="stylesheet" />
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function() {
            $('.transaction-type-radio').change(function() {
                var $cartItem = $(this).closest('.cart-item');
                var isRental = $(this).val() === 'True';
                var itemIndex = $cartItem.data('item-index');
                var purchasePrice = parseFloat($(this).data('purchase-price'));
                var rentalPrice = parseFloat($(this).data('rental-price'));
                var price = isRental ? rentalPrice : purchasePrice;

                // עדכון המחיר המוצג לפריט
                $cartItem.find('.price').text('₪' + price.toFixed(2));

                // עדכון שדה המחיר המוסתר
                $(`input[name="CartItems[${itemIndex}].Price"]`).val(price);
                $(`input[name="CartItems[${itemIndex}].IsRental"]`).val(isRental);

                // חישוב מחדש של הסכום הכולל
                updateTotalAmount();
            });

            function updateTotalAmount() {
                var totalAmount = 0;
                $('.cart-item').each(function() {
                    var price = parseFloat($(this).find('.price').text().replace('₪', ''));
                    var quantity = parseInt($(this).find('input[name$=".Quantity"]').val());
                    totalAmount += price * quantity;
                });

                $('.total-amount').text('סה"כ לתשלום: ₪' + totalAmount.toFixed(2));
            }
        });
    </script>
}