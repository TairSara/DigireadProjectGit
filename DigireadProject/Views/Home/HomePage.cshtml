@model DigireadProject.Models.ViewModels.HomeViewModel
@{
    ViewBag.Title = "דף הבית";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<main>
    <section class="welcome-section">
        <img src="~/Content/DigiRead/1.png" alt="תמונת ספרייה" class="library-poster" />
   
    </section>

    <section class="popular-books-section">
      
        <h2>ספרים פופולריים</h2>
        <div class="books-grid">
            @foreach (var book in Model.PopularBooks)
            {
                <div class="book-card">
                    <div class="book-image">
                        <img src="@book.ImageSrc" alt="@book.Title"/>
                    </div>
                    <div class="book-info">
                        <h3 class="book-title">@book.Title</h3>
                        <p class="book-author">@book.MainAuthor</p>
                        <div class="description-tooltip">
                            <div class="tooltip-text">@book.Description</div>
                        </div>
                        <div class="book-rating">
                            <div class="stars">
                                @{
                                    var rating = book.AverageRating;
                                    var fullStars = Math.Floor(rating);
                                    var hasHalfStar = (rating - fullStars) >= 0.5m;
                                }

                                @for (int i = 0; i < fullStars; i++)
                                {
                                    <i class="fa-solid fa-star active"></i>
                                }

                                @if (hasHalfStar)
                                {
                                    <i class="fa-solid fa-star-half-alt active"></i>
                                }

                                @for (int i = 0; i < 5 - Math.Ceiling(rating); i++)
                                {
                                    <i class="fa-regular fa-star"></i>
                                }
                            </div>
                            <br/>
                            <span class="average-rating">דירוג ממוצע: @rating.ToString("F1")</span>
                        </div>
                    </div>
                    <a href="@Url.Action("BookDetails", "BookManagement", new { id = book.BookID })" class="book-details-link" style="display:none;"></a>
                </div>
            }
        </div>
    </section>

    <section class="sale-books-section">
        <h2>ספרים במבצע</h2>
        <div class="books-grid">
            @foreach (var book in Model.OnSaleBooks)
            {
                <div class="book-card">
                    <div class="book-image">
                        <img src="@book.ImageSrc" alt="@book.Title" />
                    </div>
                    <div class="book-info">
                        <h3 class="book-title">@book.Title</h3>
                        <p class="book-author">@book.MainAuthor</p>
                        <div class="description-tooltip">
                            <div class="tooltip-text">@book.Description</div>
                        </div>
                        <div class="book-prices">
                            <span class="original-price">₪@book.OriginalPrice</span>
                            <span class="purchase-price">₪@book.PurchasePrice</span>
                        </div>
                    </div>
                    <a href="@Url.Action("BookDetails", "BookManagement", new { id = book.BookID })" class="book-details-link" style="display:none;"></a>
                </div>
            }
        </div>
    </section>

    <section class="recommended-series-section">
        <h2>סדרות מומלצות</h2>

        <div class="series-category">
            <h3>סדרת הלביאה הלוחמת והאריה האגדי</h3>
            <div class="books-container">
                <div class="books-grid">
                    @foreach (var book in Model.RomanceSeries)
                    {
                        <div class="book-card">
                            <div class="book-image">
                                <img src="@book.ImageSrc" alt="@book.Title" />
                            </div>
                            <div class="book-info">
                                <h3 class="book-title">@book.Title</h3>
                                <p class="book-author">@book.MainAuthor</p>
                                <div class="description-tooltip">
                                    <div class="tooltip-text">@book.Description</div>
                                </div>
                            </div>
                            <a href="@Url.Action("BookDetails", "BookManagement", new { id = book.BookID })" class="book-details-link" style="display:none;"></a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="series-category">
            <h3>סדרת הארי פוטר</h3>
            <div class="books-container">
                <div class="books-grid">
                    @foreach (var book in Model.SciFiSeries)
                    {
                        <div class="book-card">
                            <div class="book-image">
                                <img src="@book.ImageSrc" alt="@book.Title" />
                            </div>
                            <div class="book-info">
                                <h3 class="book-title">@book.Title</h3>
                                <p class="book-author">@book.MainAuthor</p>
                                <div class="description-tooltip">
                                    <div class="tooltip-text">@book.Description</div>
                                </div>
                            </div>
                            <a href="@Url.Action("BookDetails", "BookManagement", new { id = book.BookID })" class="book-details-link" style="display:none;"></a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="website-reviews-section">
        <h2>מה המשתמשים חושבים על האתר שלנו</h2>
        <div class="reviews-grid">
            @foreach (var review in Model.WebsiteReviews)
            {
                <div class="review-card">
                    <div class="review-header">
                        <div class="user-info">
                            <i class="fa-solid fa-user"></i>
                            <span class="username">@review.Username</span>
                        </div>
                        <div class="review-rating">
                            @for (int i = 0; i < review.Rating; i++)
                            {
                                <i class="fa-solid fa-star active"></i>
                            }
                            @for (int i = 0; i < 5 - review.Rating; i++)
                            {
                                <i class="fa-regular fa-star"></i>
                            }
                        </div>
                    </div>
                    <div class="review-content">
                        <p>@review.ReviewText</p>
                    </div>
                    <div class="review-date">
                        <i class="fa-regular fa-calendar"></i>
                        <span>@review.ReviewDate.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
            }
            <div class="more-reviews-button-container">
                <button id="showMoreReviews" class="more-reviews-button">
                    <i class="fa-solid fa-comments"></i>
                    הצג את כל הביקורות
                </button>
            </div>
        </div>
    </section>

    <div id="reviewsModal" class="reviews-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>כל הביקורות</h3>
                <button class="close-modal">×</button>
            </div>
            <div class="modal-body">
                @foreach (var review in Model.WebsiteReviews)
                {
                    <div class="review-card modal-review">
                        <div class="review-header">
                            <div class="user-info">
                                <i class="fa-solid fa-user"></i>
                                <span class="username">@review.Username</span>
                            </div>
                            <div class="review-rating">
                                @for (int i = 0; i < review.Rating; i++)
                                {
                                    <i class="fa-solid fa-star active"></i>
                                }
                                @for (int i = 0; i < 5 - review.Rating; i++)
                                {
                                    <i class="fa-regular fa-star"></i>
                                }
                            </div>
                        </div>
                        <div class="review-content">
                            <p>@review.ReviewText</p>
                        </div>
                        <div class="review-date">
                            <i class="fa-regular fa-calendar"></i>
                            <span>@review.ReviewDate.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <style>
        .recommended-series-section h2,
        .series-section h2 {
            font-size: 3rem !important;
            color: #2c3e50;
            margin-bottom: 2rem;
            text-align: center;
            position: relative;
            font-weight: 800;
            text-shadow: 2px 2px 4px rgba(255, 255, 255, 0.99);
        }

        .series-category {
            margin-bottom: 4rem;
            padding: 3rem 2rem;
            background: #c7b3d6;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .series-category h3 {
            color: #2c3e50;
            margin-bottom: 2rem;
            text-align: center;
            position: relative;
            font-weight: 700;
            font-size: 1.8rem;
        }

        .series-category .books-container {
            width: 100%;
            padding: 1rem;
        }

        .series-category .books-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 1.5rem;
            padding: 1.5rem;
            justify-content: center;
        }

        .series-category {
            margin-bottom: 4rem;
            padding: 0;
            background: none;
            border-radius: 0;
            box-shadow: none;
        }

        .series-category .books-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 1.5rem;
            padding: 0;
            justify-content: center;
            margin: 0;
        }

        .series-category .book-card {
            position: relative;
            width: 180px;
            aspect-ratio: 2/3;
            overflow: hidden;
            transition: transform 0.3s ease;
            cursor: pointer;
            flex-shrink: 0;
            margin: 0;
            padding: 0;
            background: none;
            border: none;
            box-shadow: none;
        }

        .series-category .book-image {
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
        }

        .series-category .book-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            margin: 0;
            padding: 0;
        }

        .series-category .book-info {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 1rem;
            background: linear-gradient(to top, rgba(0,0,0,0.8), rgba(0,0,0,0));
            color: white;
            text-align: center;
        }

        .series-category .book-title {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 0.3rem;
            color: white;
        }

        .series-category .book-author {
            font-size: 0.9rem;
            color: rgba(255,255,255,0.9);
            margin-bottom: 0.3rem;
        }

        .series-category .book-price {
            font-size: 1rem;
            color: white;
            font-weight: 500;
        }
        .series-category .book-card {
            background: #dab1f1;
            border-radius: 15px;
            padding: 1rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            cursor: pointer;
            text-align: right;
        }

        .series-category .book-info {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .series-category .book-title {
            font-size: 1.2rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 0.3rem;
        }

        .series-category .book-author {
            font-size: 1rem;
            color: #666;
            margin-bottom: 0.5rem;
        }

        .series-category .book-price {
            font-size: 1.1rem;
            color: #2c3e50;
            font-weight: 500;
            margin-top: 0.5rem;
        }

        .series-category .book-card::after,
        .series-category .book-card::before {
            display: none;
        }

        .series-category .book-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        }

        .series-category .book-image {
            width: 100%;
            aspect-ratio: 2/3;
            overflow: hidden;
            border-radius: 10px;
            margin-bottom: 1rem;
        }

        .series-category .book-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .more-reviews-button {
            background: linear-gradient(135deg, #8154a8, #a17bc6);
            color: white;
            border: none;
            padding: 1rem 2rem;
            border-radius: 50px;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin: 2rem auto;
            box-shadow: 0 4px 15px rgba(129, 84, 168, 0.3);
        }

        .more-reviews-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(129, 84, 168, 0.4);
            background: linear-gradient(135deg, #9165b9, #b28cd7);
        }

        .more-reviews-button:active {
            transform: translateY(1px);
        }

        .more-reviews-button i {
            font-size: 1.2rem;
        }

        .reviews-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 1000;
        }

        .modal-content {
            background-color: #fff;
            margin: 5% auto;
            padding: 20px;
            width: 80%;
            max-width: 800px;
            border-radius: 15px;
            position: relative;
            max-height: 80vh;
            overflow-y: auto;
            animation: modalFadeIn 0.3s ease-out;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 1rem;
            border-bottom: 2px solid #e0e0e0;
            margin-bottom: 1rem;
        }
        .colored-toast {
            background: #f4ecff !important;
            color: #6c50e8 !important;
            border: 1px solid #e6e0ff !important;
        }

        .colored-toast .swal2-icon {
            color: #6c50e8 !important;
            border-color: #6c50e8 !important;
        }

        .colored-toast .swal2-timer-progress-bar {
            background: #9580ff !important;
        }
        .modal-header h3 {
            color: #2c3e50;
            margin: 0;
            font-size: 1.5rem;
        }

        .close-modal {
            background: none;
            border: none;
            font-size: 2rem;
            color: #666;
            cursor: pointer;
            padding: 0;
            line-height: 1;
        }

     
        .close-modal:hover {
            color: #333;
        }

        .modal-body {
            padding: 1rem 0;
        }

        .modal-content {
            animation: modalFadeIn 0.3s ease-out;
        }

        .modal-review {
            margin-bottom: 1.5rem;
            padding: 1rem;
            border-radius: 10px;
            background-color: #f8f9fa;
            transition: background-color 0.2s ease;
        }

        .modal-review:hover {
            background-color: #f1f3f5;
        }
    </style>


</main>

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Content/Home/js/file-explorer.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const modal = document.getElementById('reviewsModal');
            const btn = document.getElementById('showMoreReviews');
            const closeBtn = document.querySelector('.close-modal');

            btn.onclick = function() {
                modal.style.display = "block";
                document.body.classList.add('modal-open');
            }

            closeBtn.onclick = function() {
                modal.style.display = "none";
                document.body.classList.remove('modal-open');
            }

            window.onclick = function(event) {
                if (event.target == modal) {
                    modal.style.display = "none";
                    document.body.classList.remove('modal-open');
                }
            }
        });
        document.addEventListener('DOMContentLoaded', function() {
            var successMessage = '@TempData["SuccessMessage"]';
            if (successMessage && successMessage !== '') {
                Swal.fire({
                    text: successMessage,
                    icon: 'success',
                    timer: 5000,
                    showConfirmButton: false,
                    timerProgressBar: true,
                    position: 'top',
                    toast: true,
                    customClass: {
                        popup: 'colored-toast'
                    }
                });
            }
        });
        document.addEventListener('DOMContentLoaded', function() {
            const modal = document.getElementById('reviewsModal');
            const btn = document.getElementById('showMoreReviews');
            const closeBtn = document.querySelector('.close-modal');
            const modalContent = document.querySelector('.modal-content');

            btn.onclick = function() {
                modal.style.display = "block";
                document.body.style.overflow = 'hidden'; 
                setTimeout(() => {
                    modal.style.opacity = "1";
                }, 10);
            }

            function closeModal() {
                modal.style.opacity = "0";
                setTimeout(() => {
                    modal.style.display = "none";
                    document.body.style.overflow = ''; 
                }, 300);
            }

            closeBtn.onclick = closeModal;

            modal.onclick = function(event) {
                if (event.target === modal) {
                    closeModal();
                }
            }

            modalContent.onclick = function(event) {
                event.stopPropagation();
            }

            document.addEventListener('keydown', function(event) {
                if (event.key === "Escape" && modal.style.display === "block") {
                    closeModal();
                }
            });
        });
    </script>
}
@section Styles {
    <link href="~/Content/Home/css/file-explorer.css" rel="stylesheet" />
}

