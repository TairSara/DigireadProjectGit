@model DigireadProject.Models.ViewModels.HomeViewModel
@{
    ViewBag.Title = "דף הבית";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<main>
    <!-- קודם כל התמונה -->
    <section class="welcome-section">
        <img src="~/Content/DigiRead/1.png" alt="תמונת ספרייה" class="library-poster" />

    </section>
    <!-- מתחת לתמונה - רשימת הספרים -->
    <section class="popular-books-section">
        <h2>ספרים פופולריים</h2>
        <div class="books-grid">
            @foreach (var book in Model.PopularBooks)
            {
                <div class="book-card">
                    <div class="book-image">
                        <img src="@book.ImageSrc" alt="@book.Title" />
                    </div>
                    <div class="book-info">
                        <h3 class="book-title">@book.Title</h3>
                        <p class="book-author">@book.MainAuthor</p>
                        <div class="description-tooltip">
                            <div class="tooltip-text">@book.Description</div>
                        </div>
                        <div class="book-rating">
                            <div class="stars">
                                @{
                                    var rating = book.AverageRating;
                                    var fullStars = Math.Floor(rating);
                                    var hasHalfStar = (rating - fullStars) >= 0.5m;
                                }

                                @for (int i = 0; i < fullStars; i++)
                                {
                                    <i class="fa-solid fa-star active"></i>
                                }

                                @if (hasHalfStar)
                                {
                                    <i class="fa-solid fa-star-half-alt active"></i>
                                }

                                @for (int i = 0; i < 5 - Math.Ceiling(rating); i++)
                                {
                                    <i class="fa-regular fa-star"></i>
                                }
                            </div>
                            <br/>
                            <span class="average-rating">דירוג ממוצע: @rating.ToString("F1")</span>
                        </div>
                    </div>
                    <!-- Hidden link for book details -->
                    <a href="@Url.Action("BookDetails", "BookManagement", new { id = book.BookID })" class="book-details-link" style="display:none;"></a>
                </div>
            }
        </div>
    </section>

    <!-- מתחת לספרים פופולריים - רשימת ספרים במבצע -->
    <section class="sale-books-section">
        <h2>ספרים במבצע</h2>
        <div class="books-grid">
            @foreach (var book in Model.OnSaleBooks)
            {
                <div class="book-card">
                    <div class="book-image">
                        <img src="@book.ImageSrc" alt="@book.Title" />
                    </div>
                    <div class="book-info">
                        <h3 class="book-title">@book.Title</h3>
                        <p class="book-author">@book.MainAuthor</p>
                        <div class="description-tooltip">
                            <div class="tooltip-text">@book.Description</div>
                        </div>
                        <div class="book-prices">
                            <span class="original-price">₪@book.OriginalPrice</span>
                            <span class="purchase-price">₪@book.PurchasePrice</span>
                        </div>
                    </div>
                    <a href="@Url.Action("BookDetails", "BookManagement", new { id = book.BookID })" class="book-details-link" style="display:none;"></a>
                </div>
            }

        </div>
    </section>

    <!-- סקציית סדרות מומלצות -->
    <section class="recommended-series-section">
        <h2>סדרות מומלצות</h2>

        <!-- ספרי רומן -->
        <div class="series-category">
            <h3>סדרת הלביאה הלוחמת והאריה האגדי</h3>
            <div class="books-container">
                <div class="books-grid">
                    @foreach (var book in Model.RomanceSeries)
                    {
                        <div class="book-card">
                            <div class="book-image">
                                <img src="@book.ImageSrc" alt="@book.Title" />
                            </div>
                            <div class="book-info">
                                <h3 class="book-title">@book.Title</h3>
                                <p class="book-author">@book.MainAuthor</p>
                                <div class="description-tooltip">
                                    <div class="tooltip-text">@book.Description</div>
                                </div>
                            </div>
                            <a href="@Url.Action("BookDetails", "BookManagement", new { id = book.BookID })" class="book-details-link" style="display:none;"></a>
                        </div>
                    }
                </div>
                <div class="grid-nav">
                    <button class="prev">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <button class="next">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- ספרי מדע בדיוני -->
        <div class="series-category">
            <h3>סדרת הארי פוטר</h3>
            <div class="books-container">
                <div class="books-grid">
                    @foreach (var book in Model.SciFiSeries)
                    {
                        <div class="book-card">
                            <div class="book-image">
                                <img src="@book.ImageSrc" alt="@book.Title" />
                            </div>
                            <div class="book-info">
                                <h3 class="book-title">@book.Title</h3>
                                <p class="book-author">@book.MainAuthor</p>
                                <div class="description-tooltip">
                                    <div class="tooltip-text">@book.Description</div>
                                </div>
                            </div>
                            <a href="@Url.Action("BookDetails", "BookManagement", new { id = book.BookID })" class="book-details-link" style="display:none;"></a>
                        </div>
                    }
                </div>
                <div class="grid-nav">
                    <button class="prev">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <button class="next">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </section>
    <!-- סקציית ביקורות על האתר -->
    <section class="website-reviews-section">
        <h2>מה המשתמשים חושבים על האתר שלנו</h2>
        <div class="reviews-grid">
            @foreach (var review in Model.WebsiteReviews)
            {
                <div class="review-card">
                    <div class="review-header">
                        <div class="user-info">
                            <i class="fa-solid fa-user"></i>
                            <span class="username">@review.Username</span>
                        </div>
                        <div class="review-rating">
                            @for (int i = 0; i < review.Rating; i++)
                            {
                                <i class="fa-solid fa-star active"></i>
                            }
                            @for (int i = 0; i < 5 - review.Rating; i++)
                            {
                                <i class="fa-regular fa-star"></i>
                            }
                        </div>
                    </div>
                    <div class="review-content">
                        <p>@review.ReviewText</p>
                    </div>
                    <div class="review-date">
                        <i class="fa-regular fa-calendar"></i>
                        <span>@review.ReviewDate.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
            }
            <div class="more-reviews-button-container">
                <button id="showMoreReviews" class="more-reviews-button">
                    <i class="fa-solid fa-comments"></i>
                    הצג את כל הביקורות
                </button>
            </div>
        </div>
    </section>
    <!-- Modal for all reviews -->
    <div id="reviewsModal" class="reviews-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>כל הביקורות</h3>
                <button class="close-modal">×</button>
            </div>
            <div class="modal-body">
                @foreach (var review in Model.WebsiteReviews)
                {
                    <div class="review-card modal-review">
                        <div class="review-header">
                            <div class="user-info">
                                <i class="fa-solid fa-user"></i>
                                <span class="username">@review.Username</span>
                            </div>
                            <div class="review-rating">
                                @for (int i = 0; i < review.Rating; i++)
                                {
                                    <i class="fa-solid fa-star active"></i>
                                }
                                @for (int i = 0; i < 5 - review.Rating; i++)
                                {
                                    <i class="fa-regular fa-star"></i>
                                }
                            </div>
                        </div>
                        <div class="review-content">
                            <p>@review.ReviewText</p>
                        </div>
                        <div class="review-date">
                            <i class="fa-regular fa-calendar"></i>
                            <span>@review.ReviewDate.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <style>

        /* הקטנת הכותרת הראשית */
        .recommended-series-section h2,
        .series-section h2 {
            font-size:3rem !important; /* הקטנת גודל הכותרת */
            color: #2c3e50;
            margin-bottom: 2rem;
            text-align: center;
            position: relative;
            font-weight: 800;
            text-shadow: 2px 2px 4px rgba(255, 255, 255, 0.99);
        }

        .recommended-series-section h2::after {
            content: '';
            position: absolute;
            bottom: -15px;
            left: 50%;
            transform: translateX(-50%);
            width: 150px;
            height: 4px;
            background: linear-gradient(to right, #a17bc6, #8154a8);
            border-radius: 2px;
        }

        .recommended-series-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 200px;
            background: linear-gradient(180deg, rgba(0,0,0,0.05) 0%, transparent 100%);
            pointer-events: none;
        }



        .recommended-series-section h2::after {
            content: '';
            position: absolute;
            bottom: -15px;
            left: 50%;
            transform: translateX(-50%);
            width: 150px;
            height: 4px;
            background: linear-gradient(to right, #a17bc6, #8154a8);
            border-radius: 2px;
        }

        .series-category {
            margin-bottom: 4rem;
            padding: 3rem 2rem;
            background: #c7b3d6;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .series-category h3 {
            color: #2c3e50;
            margin-bottom: 2rem;
            text-align: center;
            position: relative;
            font-weight: 700;
        }

        .colored-toast {
            background: linear-gradient(to right, #E6E6FA, #DDA0DD) !important;
            color: #4B0082 !important;
            padding: 1.5rem !important;
            width: 400px !important;  /* הגדלת רוחב החלון */
            font-size: 1.2rem !important; /* הגדלת גודל הטקסט */
        }

        .colored-toast .swal2-title,
        .colored-toast .swal2-content {
            color: #4B0082 !important;
            font-size: 1.4rem !important; /* הגדלת גודל הטקסט בכותרת ובתוכן */
            margin: 10px 0 !important; /* מרווח נוסף מעל ומתחת */
        }

        .colored-toast .swal2-timer-progress-bar {
            height: 0.3rem !important; /* הגדלת גובה שורת ההתקדמות */
            background-color: #4B0082 !important; /* שינוי צבע שורת ההתקדמות */
        }
    </style>

</main>

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Content/Home/js/file-explorer.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const modal = document.getElementById('reviewsModal');
            const btn = document.getElementById('showMoreReviews');
            const closeBtn = document.querySelector('.close-modal');

            // פתיחת המודאל
            btn.onclick = function() {
                modal.style.display = "block";
                document.body.classList.add('modal-open');
            }

            // סגירת המודאל
            closeBtn.onclick = function() {
                modal.style.display = "none";
                document.body.classList.remove('modal-open');
            }

            // סגירת המודאל בלחיצה על הרקע
            window.onclick = function(event) {
                if (event.target == modal) {
                    modal.style.display = "none";
                    document.body.classList.remove('modal-open');
                }
            }
        });
        document.addEventListener('DOMContentLoaded', function() {
            var successMessage = '@TempData["SuccessMessage"]';
            if (successMessage && successMessage !== '') {
                Swal.fire({
                    text: successMessage,
                    icon: 'success',
                    timer: 5000,
                    showConfirmButton: false,
                    timerProgressBar: true,
                    position: 'top',
                    toast: true,
                    customClass: {
                        popup: 'colored-toast'
                    }
                });
            }
        });
    </script>
}
@section Styles {
    <link href="~/Content/Home/css/file-explorer.css" rel="stylesheet" />
}

