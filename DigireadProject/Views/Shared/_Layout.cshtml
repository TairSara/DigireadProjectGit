<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Digital Books</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    @RenderSection("Styles", required: false)
    <style>
        .background-wrapper {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #FAF7F2, #FFF8EE);
            z-index: -2;
            overflow: hidden;
        }
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            z-index: 100;
            transition: transform 0.3s ease;
        }

        .navbar.hidden {
            transform: translateY(-100%);
        }

        body {
            padding-top: 80px;
        }
        .logo {
            height: 80px;
            margin-left: 5px;
        }
        .navbar-content {
            display: flex;
            width: 100%;
            align-items: center;
            gap: 20px;
        }
        .nav-links {
            display: flex;
            gap: 35px;
            align-items: center;
            margin-right: 0;
        }
        .nav-link {
            text-decoration: none;
            color: #333;
            font-size: 15px;
            padding: 8px 0;
            transition: all 0.3s ease;
            position: relative;
        }
        .nav-link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: #6B5B95;
            transition: width 0.3s ease;
        }
        .nav-link:hover::after {
            width: 100%;
        }
        .nav-link:hover {
            color: #6B5B95;
        }
        #bthn {
            position: fixed;
            bottom: 0;
            right: 5px;
            width: 15%;
            z-index: 9999;
            background: white;
        }

        /* סגנון חדש לכותרת */
        .page-title {
            text-align: center;
            font-size: 2.5em;
            font-weight: bold;
            color: #6B5B95;
            margin: 20px 0 40px 0;
            display: none; /* מוסתר כברירת מחדל */
        }

        /* הצגת הכותרת בכל הדפים חוץ מדף הבית */
        body:not(.home-page) .page-title {
            display: block;
        }
    </style>
</head>
<body class="@(ViewContext.RouteData.Values["action"].ToString() == "HomePage" ? "home-page" : "")">
<div class="background-wrapper"></div>
<nav class="navbar">
    <div class="navbar-content">
        <img src="~/Content/Illustrative-Colorful-Library--unscreen.gif" alt="Logo" class="logo">
        <div class="nav-links">
            <a href="@Url.Action("HomePage", "Home")" class="nav-link">
                <i class="fas fa-home"></i>
                <span>דף הבית</span>
            </a>
            <a href="@Url.Action("Login", "Account")" class="nav-link">
                <i class="fas fa-sign-in-alt"></i>
                <span>התחברות</span>
            </a>
            <a href="@Url.Action("Register", "Account")" class="nav-link">
                <i class="fas fa-user-plus"></i>
                <span>הרשמה</span>
            </a>
            <a href="@Url.Action("Profile", "Account")" class="nav-link">
                <i class="fas fa-user-circle"></i>
                <span>פרופיל אישי</span>
            </a>
            <a href="@Url.Action("MainGallery", "BookManagement")" class="nav-link">
                <i class="fas fa-book"></i>
                <span>גלריית ספרים</span>
            </a>
            <a href="@Url.Action("Cart", "ShoppingCart")" class="nav-link">
                <i class="fas fa-cart-plus"></i>
                <span>עגלה</span>
            </a>
            <a href="@Url.Action("MyLibrary", "BookManagement")" class="nav-link">
                <i class="fas fa-book-reader"></i>
                <span>הספרייה שלי</span>
            </a>
            <a href="@Url.Action("MyWaitList", "BookManagement")" class="nav-link">
                <i class="fas fa-list-alt"></i>
                <span>רשימת המתנה</span>
            </a>
            <a href="@Url.Action("Logout", "Account")" class="nav-link">
                <i class="fas fa-sign-out-alt"></i>
                <span>התנתקות</span>
            </a>
        </div>
    </div>
</nav>

<div class="page-title"><img src="~/Content/DigiRead/main.png" alt="DIGIREAD" class="title-logo"></div>

<div>@RenderBody()</div>
<div id="bthn"></div>

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/bootstrap")
@RenderSection("scripts", required: false)
<script>
    (function() {
        var script = document.createElement("script");
        script.src = "https://bringthemhomenow.net/1.0.8/hostages-ticker.js";
        script.setAttribute("crossorigin", "anonymous");
        document.head.appendChild(script);
    })();
</script>
</body>
</html>