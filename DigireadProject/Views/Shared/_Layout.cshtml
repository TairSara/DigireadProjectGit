<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Digital Books</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    @RenderSection("Styles", required: false)
    <style>
        .background-wrapper {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #FAF7F2, #FFF8EE);
            z-index: -2;
            overflow: hidden;
        }

        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            z-index: 100;
            transition: transform 0.3s ease;
            background: linear-gradient(135deg, #FAF7F2, #FFF8EE);
        }

        .navbar.hidden {
            transform: translateY(-100%);
        }

        body {
            padding-top: 80px;
            font-family: Calibri, 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* מוודא שכל האלמנטים יורשים את הגופן */
        * {
            font-family: inherit;
        }

        .logo {
            height: 80px;
            margin-left: 5px;
        }

        .navbar-content {
            display: flex;
            width: 100%;
            align-items: center;
            gap: 20px;
        }

        .nav-links {
            display: flex;
            gap: 35px;
            align-items: center;
            margin-right: 0;
        }

        .nav-link {
            text-decoration: none;
            color: #333;
            font-size: 15px;
            padding: 8px 0;
            transition: all 0.3s ease;
            position: relative;
            cursor: pointer;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: #6B5B95;
            transition: width 0.3s ease;
        }

        .nav-link:hover::after {
            width: 100%;
        }

        .nav-link:hover {
            color: #6B5B95;
        }

        .nav-link button {
            background: none;
            border: none;
            padding: 0;
            font: inherit;
            color: inherit;
            cursor: pointer;
        }

        .social-links {
            display: flex;
            gap: 15px;
            margin-right: auto;
            margin-left: 20px;
        }

        .social-link {
            color: #6B5B95;
            font-size: 20px;
            transition: all 0.3s ease;
            padding: 8px;
            border-radius: 50%;
            background: rgba(107, 91, 149, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
        }

        .social-link:hover {
            transform: translateY(-3px);
            background: #6B5B95;
            color: #fff;
        }

        #bthn {
            position: fixed;
            bottom: 0;
            right: 5px;
            width: 15%;
            z-index: 9999;
            background: white;
        }

        .page-title {
            text-align: center;
            font-size: 2.5em;
            font-weight: bold;
            color: #6B5B95;
            margin: 20px 0 40px 0;
            display: none;
        }

        body:not(.home-page) .page-title {
            display: block;
        }

        .star-rating .star {
            font-size: 24px;
            color: #ddd;
            cursor: pointer;
            transition: color 0.2s;
            margin: 0 2px;
        }

        .star-rating .star.active,
        .star-rating .star.selected {
            color: #FFD700;
        }

        .rating-container {
            text-align: center;
            margin-bottom: 20px;
        }

        #rating-text {
            margin-top: 10px;
            font-size: 16px;
            color: #666;
        }

        .swal2-textarea {
            direction: rtl;
            text-align: right;
            min-height: 100px;
            margin-top: 15px;
        }
    </style>
</head>
<body class="@(ViewContext.RouteData.Values["action"].ToString() == "HomePage" ? "home-page" : "")">
@Html.AntiForgeryToken()
<div class="background-wrapper"></div>

<nav class="navbar">
    <div class="navbar-content">
        <img src="~/Content/Illustrative-Colorful-Library--unscreen.gif" alt="Logo" class="logo">
        <div class="nav-links">
            <!-- קישורים שמוצגים לכולם -->
            <a href="@Url.Action("HomePage", "Home")" class="nav-link">
                <i class="fas fa-home"></i>
                <span>דף הבית</span>
            </a>
            <a href="@Url.Action("MainGallery", "BookManagement")" class="nav-link">
                <i class="fas fa-book"></i>
                <span>גלריית ספרים</span>
            </a>
            <a href="@Url.Action("About", "Home")" class="nav-link">
                <i class="fas fa-info-circle"></i>
                <span>אודות</span>
            </a>

            @if (Session["UserID"] == null)
            {
                <!-- קישורים למשתמשים לא מחוברים -->
                <a href="@Url.Action("Login", "Account")" class="nav-link">
                    <i class="fas fa-sign-in-alt"></i>
                    <span>התחברות</span>
                </a>
                <a href="@Url.Action("Register", "Account")" class="nav-link">
                    <i class="fas fa-user-plus"></i>
                    <span>הרשמה</span>
                </a>
            }
            else
            {
                <!-- קישורים למשתמשים מחוברים -->
                <a href="@Url.Action("Profile", "Account")" class="nav-link">
                    <i class="fas fa-user-circle"></i>
                    <span>פרופיל אישי</span>
                </a>
                <a href="@Url.Action("Cart", "ShoppingCart")" class="nav-link">
                    <i class="fas fa-cart-plus"></i>
                    <span>עגלה</span>
                </a>
                <a href="@Url.Action("MyLibrary", "BookManagement")" class="nav-link">
                    <i class="fas fa-book-reader"></i>
                    <span>הספרייה שלי</span>
                </a>
                <a href="@Url.Action("MyWaitList", "BookManagement")" class="nav-link">
                    <i class="fas fa-list-alt"></i>
                    <span>רשימת המתנה</span>
                </a>
                <a href="@Url.Action("Index", "Wishlist")" class="nav-link">
                    <i class="far fa-heart"></i>
                    <span>הספרים שאהבתי</span>
                </a>

                if (ViewBag.HasWaitListItems ?? false)
                {
                    <a href="@Url.Action("MyWaitList", "BookManagement")" class="nav-link">
                        <i class="fas fa-list-alt"></i>
                        <span>רשימת המתנה</span>
                    </a>
                }

                <span class="nav-link" id="rateWebsiteBtn">
                        <i class="fas fa-star"></i>
                        <span>דרג אותנו</span>
                    </span>

                if (Session["IsAdmin"]?.ToString() == "True")
                {
                    <!-- קישורים למנהל -->
                    <a href="@Url.Action("Dashboard", "Admin")" class="nav-link">
                        <i class="fas fa-cogs"></i>
                        <span>לוח ניהול</span>
                    </a>
                }

                <a href="@Url.Action("Logout", "Account")" class="nav-link">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>התנתקות</span>
                </a>
            }

            <!-- רשתות חברתיות -->
            <div class="social-links">
                <a href="https://www.facebook.com" class="social-link" title="פייסבוק" target="_blank">
                    <i class="fab fa-facebook-f"></i>
                </a>
                <a href="https://www.instagram.com" class="social-link" title="אינסטגרם" target="_blank">
                    <i class="fab fa-instagram"></i>
                </a>
                <a href="https://www.twitter.com" class="social-link" title="טוויטר" target="_blank">
                    <i class="fab fa-twitter"></i>
                </a>
                <a href="https://www.linkedin.com" class="social-link" title="לינקדאין" target="_blank">
                    <i class="fab fa-linkedin-in"></i>
                </a>
            </div>
        </div>
    </div>
</nav>

<div class="page-title">
    <img src="~/Content/DigiRead/main.png" alt="DIGIREAD" class="title-logo">
</div>

<div>@RenderBody()</div>
<div id="bthn"></div>

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/bootstrap")
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/js/all.min.js"></script>

<script>
    $(document).ready(function() {
        $('#rateWebsiteBtn').on('click', function() {
            showWebsiteRatingDialog();
        });
    });

    function showWebsiteRatingDialog() {
        $.get('/Reviews/HasUserReviewedWebsite', function(response) {
            if (response.hasReviewed) {
                Swal.fire({
                    icon: 'warning',
                    title: 'לא ניתן לדרג',
                    text: 'כבר דירגת את האתר בעבר',
                    confirmButtonText: 'אישור'
                });
                return;
            }

            let currentRating = 0;

            Swal.fire({
                title: 'דרג את האתר',
                html: `
                    <div class="rating-container">
                        <div class="star-rating">
                            <span class="star" data-rating="1" role="button">★</span>
                            <span class="star" data-rating="2" role="button">★</span>
                            <span class="star" data-rating="3" role="button">★</span>
                            <span class="star" data-rating="4" role="button">★</span>
                            <span class="star" data-rating="5" role="button">★</span>
                        </div>
                        <div id="rating-text">בחר דירוג</div>
                    </div>
                    <textarea id="reviewText" class="swal2-textarea" placeholder="נשמח לשמוע את חוות דעתך..." dir="rtl"></textarea>
                `,
                showCancelButton: true,
                confirmButtonText: 'שלח דירוג',
                cancelButtonText: 'ביטול',
                didOpen: (popup) => {
                    const stars = popup.querySelectorAll('.star');
                    const ratingText = popup.querySelector('#rating-text');
                    const ratingDescriptions = ['גרוע', 'לא טוב', 'סביר', 'טוב', 'מצוין'];

                    stars.forEach(star => {
                        star.addEventListener('mouseenter', () => {
                            const rating = parseInt(star.dataset.rating);
                            stars.forEach((s, index) => {
                                if (index < rating) {
                                    s.classList.add('active');
                                } else {
                                    s.classList.remove('active');
                                }
                            });
                            ratingText.textContent = ratingDescriptions[rating - 1];
                        });

                        star.addEventListener('click', () => {
                            currentRating = parseInt(star.dataset.rating);
                            stars.forEach((s, index) => {
                                if (index < currentRating) {
                                    s.classList.add('selected');
                                } else {
                                    s.classList.remove('selected');
                                }
                            });
                            ratingText.textContent = ratingDescriptions[currentRating - 1];
                        });
                    });

                    popup.querySelector('.star-rating').addEventListener('mouseleave', () => {
                        stars.forEach((s, index) => {
                            if (index < currentRating) {
                                s.classList.add('selected');
                            } else {
                                s.classList.remove('active', 'selected');
                            }
                        });
                        ratingText.textContent = currentRating ?
                            ratingDescriptions[currentRating - 1] : 'בחר דירוג';
                    });
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    if (currentRating === 0) {
                        Swal.fire('שגיאה', 'אנא בחר דירוג', 'error');
                        return;
                    }
                    const reviewText = document.getElementById('reviewText').value;
                    submitWebsiteRating(currentRating, reviewText);
                }
            });
        });
    }

    function submitWebsiteRating(rating, reviewText) {
        $.ajax({
            url: '/Reviews/AddWebsiteReview',
            type: 'POST',
            data: {
                rating: rating,
                reviewText: reviewText,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            beforeSend: function() {
                Swal.showLoading();
            },
            success: function(response) {
                if (response.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'תודה!',
                        text: 'הדירוג נשמר בהצלחה',
                        confirmButtonText: 'אישור'
                    });
                } else {
                    if (response.message === "יש להתחבר למערכת") {
                        Swal.fire({
                            title: 'שגיאה',
                            text: 'יש להתחבר למערכת כדי לדרג את האתר',
                            icon: 'error',
                            confirmButtonText: 'התחבר',
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location.href = '/Account/Login';
                            }
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'שגיאה',
                            text: response.message || 'אירעה שגיאה בשמירת הדירוג',
                            confirmButtonText: 'אישור'
                        });
                    }
                }
            },
            error: function() {
                Swal.fire({
                    icon: 'error',
                    title: 'שגיאה',
                    text: 'אירעה שגיאה בשמירת הדירוג',
                    icon: 'error',
                    title: 'שגיאה',
                    text: 'אירעה שגיאה בשמירת הדירוג',
                    confirmButtonText: 'אישור'
                });
            }
        });
    }
</script>
@RenderSection("scripts", required: false)
<script>
    (function() {
        var script = document.createElement("script");
        script.src = "https://bringthemhomenow.net/1.0.8/hostages-ticker.js";
        script.setAttribute("crossorigin", "anonymous");
        document.head.appendChild(script);
    })();
</script>
</body>
</html>